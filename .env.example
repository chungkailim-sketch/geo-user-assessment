# Enables live web-search scoring of YouTube / Reddit / LinkedIn / news authority, AI industry and
# leader identification, and the AI-written parts of the full PDF report. Without it, authority is
# estimated from on-site signals and marked "limited", and there is no industry benchmark.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Set to true when deployed behind a reverse proxy (Railway, Render, etc.) so rate limits use the
# real client IP from X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Optional tuning
MAX_PAGES=10
USER_CACHE_TTL_SECONDS=86400
LEADER_CACHE_TTL_SECONDS=604800
RATE_LIMIT=5/minute

# Full PDF report by email ("发送完整PDF报告至我的邮箱"). The feature is off until SMTP_HOST and
# SMTP_FROM are set. Microsoft 365: smtp.office365.com / 587 / starttls; Gmail: smtp.gmail.com / 587 /
# starttls with an app password; SendGrid: smtp.sendgrid.net / 587 / username "apikey".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=罗德出海GEO准备度评估
SMTP_REPLY_TO=
# Optional: internal copy of every report sent (comma-separated addresses)
REPORT_BCC=
