# Enables live web-search scoring of YouTube / Reddit / LinkedIn / news authority and AI industry
# detection (including industries outside the default seven). Without it, authority is estimated
# from on-site signals and marked "limited", and industries are matched by keywords only.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Set to true when deployed behind a reverse proxy (Railway, Render, etc.) so rate limits use the
# real client IP from X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Optional tuning
MAX_PAGES=6
USER_CACHE_TTL_SECONDS=86400
LEADER_CACHE_TTL_SECONDS=604800
RATE_LIMIT=5/minute
