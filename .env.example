# Enables live web-search scoring of YouTube / Reddit / LinkedIn / news authority.
# Without it, authority is estimated from on-site signals and marked "limited".
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Optional tuning
MAX_PAGES=6
USER_CACHE_TTL_SECONDS=86400
LEADER_CACHE_TTL_SECONDS=604800
RATE_LIMIT=5/minute
